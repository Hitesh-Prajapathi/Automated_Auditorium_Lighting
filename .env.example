# Lumina Intelligence — Environment Variables
# Copy this file to .env and fill in your API keys

# Required: Mistral AI API key for PDF OCR processing
MISTRAL_API_KEY=your_mistral_api_key_here

# Required: HuggingFace API token for LLM inference (Qwen, Llama)
HF_API_TOKEN=your_huggingface_token_here

# Optional: OpenAI API key (enables GPT-4 lighting generation mode)
# OPENAI_API_KEY=your_openai_api_key_here
